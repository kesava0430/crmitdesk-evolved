# Used by docker-compose.yml
# Copy to .env and fill in real values before running docker compose up

# ─── Required secrets (generate with: openssl rand -hex 64) ─────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── CORS / Frontend URL ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── SMTP (optional — leave blank to disable email) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Google OAuth (optional) — Drive storage, Sign-In, and Calendar sync ────
# One OAuth 2.0 Client ID (console.cloud.google.com > APIs & Services >
# Credentials) covers all three features below; only the redirect URIs
# registered on it differ.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This server's own public URL, used to build OAuth redirect URIs. Add BOTH
# of these as Authorized redirect URIs on the OAuth client:
#   <APP_URL>/api/storage/google/callback   (Google Drive file storage)
#   <APP_URL>/api/calendar/callback         (Calendar sync)
APP_URL=http://localhost:4000
# For the "Sign in with Google" button (login only, no redirect involved),
# also set GOOGLE_CLIENT_ID as VITE_GOOGLE_CLIENT_ID in the client build env
# (same value — safe to expose client-side, Google's docs are explicit that
# the Client ID itself isn't a secret).

# ─── Quote e-signature links (optional) ──────────────────────────────────────
# Secret used to sign public quote-sharing links. Falls back to JWT_SECRET if
# unset, so this is optional, but setting a dedicated value means rotating
# JWT_SECRET later won't also invalidate every outstanding quote link.
QUOTE_SHARE_SECRET=
