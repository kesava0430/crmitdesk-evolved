# Used by docker-compose.yml
# Copy to .env and fill in real values before running docker compose up

# ─── Required secrets (generate with: openssl rand -hex 64) ─────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── CORS / Frontend URL ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── SMTP (optional — leave blank to disable email) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
