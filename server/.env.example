# Every variable below is one this codebase actually reads. Generated by
# grepping `process.env.*` across server/src, so it should not drift.
# Anything left blank is optional — the feature that needs it degrades with a
# clear message rather than crashing.

# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/crmitdesk
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=15m
# Encrypts OAuth refresh tokens, mail passwords and the employee bank/tax
# columns before they reach the database. REQUIRED. 32+ random characters.
ENCRYPTION_KEY=change-me-32-plus-random-characters
NODE_ENV=production
PORT=4000

# The backend's OWN public URL. Used to build links back to this API — the
# Google OAuth redirect URI and CSAT survey links. Must be internet-reachable
# in production, not localhost.
APP_URL=https://app.zenkara.in/zenkara
# Where users' browsers live — OAuth sends them back here after consent.
FRONTEND_URL=https://app.zenkara.in/zenkara
# Origin only — scheme + host, no path, no trailing slash. Several may be
# listed, comma-separated. The Android app's WebView origins
# (http://localhost, https://localhost, capacitor://localhost) are always
# added so its live-updates stream works; CORS_ALLOW_APP_ORIGINS=false opts out.
CORS_ORIGIN=https://app.zenkara.in
CORS_ALLOW_APP_ORIGINS=

# ─── Sessions ────────────────────────────────────────────────────────────────
# Sliding refresh-token lifetime in days (each refresh restarts the window).
# Browser sessions default to 7, the Android app (X-Client: native-*) to 90.
REFRESH_TTL_DAYS=7
REFRESH_TTL_DAYS_NATIVE=90
# How long a just-rotated refresh token keeps working (seconds, max 600) for
# clients that lost the refresh response. Default 120, clamped to 10–600;
# blank means default.
REFRESH_GRACE_SECONDS=120
# Rotated tokens are kept this long (hours) so a client that missed a refresh
# response can replay it; the hourly purge drops them afterwards. Default 72.
REFRESH_ROTATED_RETENTION_HOURS=72
# Where Microsoft sign-in started from the Android app returns to (deep link
# registered in client/android AndroidManifest.xml). Default shown.
APP_SSO_REDIRECT_URL=com.zenkara.app://sso-callback

# ─── Attachment storage ──────────────────────────────────────────────────────
# Full walkthrough: STORAGE-SETUP.md at the repo root.
#
# Google Drive — bring-your-own. Each CLIENT ORG connects their own Google
# account from Settings → Integrations → Storage; these two variables only
# enable that button. Without them it is disabled with an explanatory message.
#
# Authorised redirect URI to register in Google Cloud Console — must match
# byte for byte:   ${APP_URL}/api/storage/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hosted storage — ONE bucket you own, shared by every org, objects namespaced
# by orgId. Offered only to orgs whose plan carries a quota
# (Free 0GB / Pro 5GB / Enterprise 50GB).
#
# These are a FALLBACK. A PLATFORM_ADMIN can set the same values in the console
# (Platform Admin → Platform settings → Hosted attachment storage), which wins
# per field and takes effect with no redeploy. Leave a console field blank to
# keep using the env var below.
#
# Nothing here is needed for customers who bring their OWN S3 bucket — that
# path requires no deployment configuration at all.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Omit for real AWS S3; set it for R2 / MinIO / other S3-compatible gateways.
S3_ENDPOINT=

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
# Per-1K-token pricing, used to cost interactions in the AI governance ledger.
OPENAI_INPUT_COST_PER_1K=
OPENAI_OUTPUT_COST_PER_1K=
GROQ_INPUT_COST_PER_1K=
GROQ_OUTPUT_COST_PER_1K=
# Hard ceiling on a single model call. Defaults to 30000 (30s).
AI_REQUEST_TIMEOUT_MS=30000
# Model overrides. Providers retire models on their own schedule (Groq
# decommissioned llama-3.1-8b-instant and llama-3.3-70b-versatile on
# 2026-08-16 and broke every AI feature until the defaults were updated) —
# when that happens again, set the replacement model IDs here and restart;
# no code change needed. Defaults: openai/gpt-oss-20b / openai/gpt-oss-120b
# on Groq, gpt-4o-mini / gpt-4o on OpenAI.
AI_MODEL_FAST=
AI_MODEL_SMART=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# Setup steps: deploy/README.md → "Billing (Stripe)". Online checkout is only
# offered when BOTH keys are set; without them the Billing page tells customers
# to contact you and checkout/portal return 503.
STRIPE_SECRET_KEY=                    # sk_live_… / sk_test_… (Developers → API keys)
STRIPE_WEBHOOK_SECRET=                # whsec_… of the endpoint …/api/billing/webhook
STRIPE_AUTOMATIC_TAX=false            # true only after Stripe Tax is set up (GST/VAT registrations)
STRIPE_PRODUCT_PREFIX=Zenkara 360     # product name prefix shown on invoices / checkout
# No longer used — every checkout is priced from Platform Admin → Pricing:
# STRIPE_PRO_PRICE_ID=
# STRIPE_ENTERPRISE_PRICE_ID=
# FRONTEND_URL (above) must include the app's base path, e.g.
# https://app.zenkara.in/zenkara — Stripe redirects back to FRONTEND_URL/billing.

# Licensing defaults (see server/src/utils/pricing.ts). Every one of these is
# also editable in Platform Admin → Pricing, which wins over the env value.
LICENSE_BASE_SEAT_PRICE_CENTS=800     # platform base per seat/month, in minor units (cents / paise)
LICENSE_CUSTOM_STORAGE_GB=10          # hosted storage included with the hosted_storage module
LICENSE_YEARLY_MONTHS_CHARGED=10      # yearly billing = 12 months for the price of N
LICENSE_GRACE_PERIOD_DAYS=7           # paid access continues this long after a failed payment
LICENSE_CURRENCY=usd                  # usd | inr | eur … (lowercase ISO code)
LICENSE_TRIAL_DAYS=0                  # free trial at first checkout; 0 = off
BILLING_CONTACT_EMAIL=                # shown when online payment isn't available

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Alternative to SMTP.
RESEND_API_KEY=
RESEND_FROM=
ADMIN_NOTIFY_EMAIL=

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Web push ────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ─── Android app push (Firebase Cloud Messaging) ─────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new
# private key. Paste the JSON (or base64 of it) on one line. Left blank, app
# push is simply off — nothing else changes. The app must also be built with
# VITE_FCM_ENABLED=true and google-services.json (see client/android/README).
FCM_SERVICE_ACCOUNT_JSON=
# Optional — defaults to project_id inside the key.
FCM_PROJECT_ID=

# ─── Shared secrets for unauthenticated endpoints ────────────────────────────
# Each guards a route that has no logged-in user to authenticate.
QUOTE_SHARE_SECRET=          # signs public quote-view links
WORKFLOW_WEBHOOK_SECRET=     # fallback signing key for outbound webhooks
DIRECTORY_SYNC_SECRET=       # SCIM / directory sync push endpoint
DEMO_RESET_SECRET=           # lets the demo org be reseeded without a shell
PLATFORM_BOOTSTRAP_SECRET=   # creates the first PLATFORM_ADMIN

# ─── Demo ────────────────────────────────────────────────────────────────────
DEMO_LOGIN_EMAIL=
