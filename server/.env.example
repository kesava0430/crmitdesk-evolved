# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Add connect_timeout=30 if using Neon free tier (auto-suspends)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_with_crypto_randomBytes_64"
JWT_REFRESH_SECRET="CHANGE_ME_must_be_different_from_JWT_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encrypts connected-mailbox (IMAP/SMTP) passwords at rest. Any long random
# string works — it's hashed down to a key internally. Changing this after
# an email account has been connected will make its stored password
# undecryptable, so treat it like a secret you back up alongside JWT_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="CHANGE_ME_generate_with_crypto_randomBytes_32"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production (no trailing slash)
CORS_ORIGIN="https://yourapp.com"

# ─── Frontend URL (used in invite email links) ───────────────────────────────
FRONTEND_URL="https://yourapp.com"

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Leave blank to disable email — invite links will be returned via API only
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="CRM & IT Desk <noreply@yourapp.com>"

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Twilio WhatsApp ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_FROM_NUMBER="whatsapp:+14155238886"

# ─── Workflow webhooks ───────────────────────────────────────────────────────
# Signs outgoing SEND_WEBHOOK automation payloads (HMAC-SHA256, header
# X-Webhook-Signature: sha256=<hex>) so receivers can verify authenticity.
# Optional — if unset, webhooks still send, just unsigned.
WORKFLOW_WEBHOOK_SECRET="CHANGE_ME_generate_with_crypto_randomBytes_32"

# ─── Stripe Billing ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create prices in Stripe dashboard, then paste IDs here
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."
