# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Add connect_timeout=30 if using Neon free tier (auto-suspends)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_with_crypto_randomBytes_64"
JWT_REFRESH_SECRET="CHANGE_ME_must_be_different_from_JWT_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encrypts connected-mailbox (IMAP/SMTP) passwords at rest. Any long random
# string works — it's hashed down to a key internally. Changing this after
# an email account has been connected will make its stored password
# undecryptable, so treat it like a secret you back up alongside JWT_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="CHANGE_ME_generate_with_crypto_randomBytes_32"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production (no trailing slash)
CORS_ORIGIN="https://yourapp.com"

# ─── Frontend URL (used in invite email links) ───────────────────────────────
FRONTEND_URL="https://yourapp.com"

# ─── App URL (this backend's own public URL) ─────────────────────────────────
# Used wherever the code needs to link back to itself rather than to the
# frontend: CSAT survey links (mailer.ts) and the Google OAuth redirect_uri
# (storage.controller.ts). Must be internet-reachable, not localhost.
APP_URL="https://api.yourapp.com"

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend (HTTP API, port 443) is tried first if RESEND_API_KEY is set — use
# this on Render's free tier, which blocks outbound SMTP (25/465/587)
# entirely. SMTP below is the fallback, for local dev or a paid host where
# outbound SMTP isn't blocked. Leave both unset to disable email — invite
# links will be returned via API only, and mailer.ts logs a message instead
# of sending.
RESEND_API_KEY="re_..."
RESEND_FROM="CRM & IT Desk <noreply@yourdomain.com>"   # optional, falls back to SMTP_FROM

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="CRM & IT Desk <noreply@yourapp.com>"

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ─── Attachments: Google Drive (bring-your-own) ──────────────────────────────
# OAuth 2.0 Client ID (Web application type) from Google Cloud Console, with
# the Google Drive API enabled and {APP_URL}/api/storage/google/callback
# added as an authorized redirect URI. Until both are set, Settings →
# Storage tells the user Google Drive isn't configured.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ─── Attachments: hosted storage (alternative to bring-your-own Drive) ───────
# Only available to plans with a non-zero storageQuotaGB (utils/stripe.ts) —
# Free orgs must use their own Drive. Any S3-compatible bucket works;
# Cloudflare R2 is the cheapest (no egress fees):
#   S3_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com, S3_REGION = auto
# For real AWS S3, leave S3_ENDPOINT unset and set S3_REGION to the bucket's
# region instead. Until S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are
# all set, Settings → Storage only offers Google Drive, regardless of plan.
S3_ENDPOINT="https://xxxxxxxxxxxx.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="crmitdesk-attachments"
S3_ACCESS_KEY_ID="xxxxxxxxxxxx"
S3_SECRET_ACCESS_KEY="xxxxxxxxxxxx"

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Twilio WhatsApp ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_FROM_NUMBER="whatsapp:+14155238886"

# ─── Workflow webhooks ───────────────────────────────────────────────────────
# Signs outgoing SEND_WEBHOOK automation payloads (HMAC-SHA256, header
# X-Webhook-Signature: sha256=<hex>) so receivers can verify authenticity.
# Optional — if unset, webhooks still send, just unsigned.
WORKFLOW_WEBHOOK_SECRET="CHANGE_ME_generate_with_crypto_randomBytes_32"

# ─── Demo reset (public showcase org) ────────────────────────────────────────
# Shared secret for POST /api/demo/reset (server/src/modules/demo), which
# re-seeds the public "TechCorp Solutions" demo org from scratch. Called by
# .github/workflows/reset-demo.yml on a nightly schedule. Set the same value
# here and as the DEMO_RESET_SECRET secret in the GitHub repo. Leave unset
# to disable the endpoint entirely (it responds 404).
DEMO_RESET_SECRET="CHANGE_ME_generate_with_crypto_randomBytes_32"

# ─── Stripe Billing ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create prices in Stripe dashboard, then paste IDs here
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."
