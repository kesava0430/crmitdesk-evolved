// A user-scheduled reminder/follow-up on a Deal or Ticket that fires a
// WhatsApp notification when it's due. Polled by a lightweight in-process
// scheduler (see server/src/utils/scheduler.ts) rather than a job queue —
// this app runs as a single Node process, so a periodic DB poll is enough.
model Schedule {
  id            String       @id @default(cuid())
  orgId         String       @map("org_id")
  entityType    String       @map("entity_type") // TICKET | DEAL
  entityId      String       @map("entity_id")
  dueAt         DateTime     @map("due_at")
  recurrence    String       @default("NONE") @map("recurrence") // NONE | DAILY | WEEKLY
  message       String
  recipientType String       @map("recipient_type") // CONTACT | ASSIGNEE | CUSTOM_NUMBER | ORG_DEFAULT
  customNumber  String?      @map("custom_number")
  status        String       @default("PENDING") @map("status") // PENDING | SENT | FAILED | CANCELLED
  lastError     String?      @map("last_error")
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sentAt        DateTime?    @map("sent_at")
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator       User         @relation(fields: [createdBy], references: [id])

  @@index([orgId, entityType, entityId])
  @@index([status, dueAt])
  @@map("schedules")
}

