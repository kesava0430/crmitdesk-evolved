model CustomField {
  id         String             @id @default(cuid())
  orgId      String             @map("org_id")
  entityType String             @map("entity_type")
  label      String
  fieldKey   String             @map("field_key")
  fieldType  String             @map("field_type")
  options    Json?
  required   Boolean            @default(false)
  position   Int                @default(0)
  createdAt  DateTime           @default(now()) @map("created_at")
  values     CustomFieldValue[]
  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, fieldKey])
  @@index([orgId, entityType])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String      @map("custom_field_id")
  entityId      String      @map("entity_id")
  value         String?
  field         CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

// ─── Custom Modules (no-code object builder) ───────────────────────────────────
//
// Distinct from CustomField above: CustomField bolts extra fields onto an
// *existing* entity (Ticket/Deal/...). A CustomModule is a brand-new entity
// type an org admin defines from scratch — its own fields, its own records,
// its own nav entry — closer to a Salesforce custom object than a form
// field. Record data is stored schemaless as `data: Json` keyed by
// `fieldKey` (mirrors the CustomFieldValue pattern of storing everything as
// a string-able value) rather than a dynamically-altered SQL table, since
// Postgres DDL can't be safely run per-tenant from application code.
model CustomModule {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  name        String
  slug        String
  icon        String    @default("Layers")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fields      CustomModuleField[]
  records     CustomModuleRecord[]
  syncConfig  ExternalSyncConfig?

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("custom_modules")
}

model CustomModuleField {
  id        String       @id @default(cuid())
  moduleId  String       @map("module_id")
  label     String
  fieldKey  String       @map("field_key")
  // TEXT | TEXTAREA | NUMBER | CURRENCY | DATE | BOOLEAN | DROPDOWN | EMAIL | PHONE | URL
  fieldType String       @map("field_type")
  options   Json?        // DROPDOWN: string[] of choices
  required  Boolean      @default(false)
  isPrimary Boolean      @default(false) @map("is_primary") // rendered as the record's title in list views
  position  Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  module    CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, fieldKey])
  @@index([moduleId])
  @@map("custom_module_fields")
}

model CustomModuleRecord {
  id         String       @id @default(cuid())
  moduleId   String       @map("module_id")
  orgId      String       @map("org_id")
  data       Json         // { [fieldKey]: value }
  source     String       @default("MANUAL") // MANUAL | SYNC
  // Dedupe key for SYNC-sourced records — the value of the external system's
  // id field (ExternalSyncConfig.externalIdField), so re-polling upserts
  // instead of duplicating. Null for MANUAL records.
  externalId String?      @map("external_id")
  createdBy  String?      @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  module     CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([moduleId, externalId])
  @@index([moduleId])
  @@index([orgId])
  @@map("custom_module_records")
}

// Outbound-polling sync: we periodically GET/POST a configured external URL,
// pull records out of the response (at `recordPath`), validate each one
// against the module's field schema, and upsert into CustomModuleRecord
// (deduped on `externalIdField`). Follows the same setInterval-poller shape
// as scheduler.ts — see server/src/utils/customModuleSync.ts.
model ExternalSyncConfig {
  id              String       @id @default(cuid())
  moduleId        String       @unique @map("module_id")
  url             String
  method          String       @default("GET")
  authType        String       @default("NONE") @map("auth_type") // NONE | API_KEY | BEARER
  authHeaderName  String?      @map("auth_header_name")
  authValue       String?      @map("auth_value")
  pollIntervalMin Int          @default(15) @map("poll_interval_min")
  recordPath      String?      @map("record_path")       // dot path to the array of records in the response, e.g. "data.items"
  externalIdField String?      @map("external_id_field") // key (in the *external* record) used to dedupe on re-sync
  fieldMapping    Json         @map("field_mapping")      // { [customModuleFieldKey]: externalResponseKey }
  isActive        Boolean      @default(true) @map("is_active")
  lastSyncAt      DateTime?    @map("last_sync_at")
  lastStatus      String?      @map("last_status") // SUCCESS | FAILED
  lastError       String?      @map("last_error")
  lastRecordCount Int?         @map("last_record_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  module          CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("external_sync_configs")
}

// ─── Templates ────────────────────────────────────────────────────────────────

// A named set of default field values (standard + custom) for one entity
// type. Picking a template on the entity's "New" form pre-fills the form —
// it does not create the record by itself.
model RecordTemplate {
  id                String       @id @default(cuid())
  orgId             String       @map("org_id")
  entityType        String       @map("entity_type") // TICKET | CONTACT | DEAL | LEAD
  name              String
  description       String?
  fieldValues       Json         @map("field_values")       // default values for standard fields, e.g. { priority: "HIGH" }
  customFieldValues Json?        @map("custom_field_values") // default values for custom fields, keyed by fieldKey
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, name])
  @@index([orgId, entityType])
  @@map("record_templates")
}

// Canned responses agents can insert while replying/commenting on a ticket.
model ReplyTemplate {
  id        String       @id @default(cuid())
  orgId     String       @map("org_id")
  name      String
  body      String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

