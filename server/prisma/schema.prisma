model Conversation {
  id            String       @id @default(cuid())
  orgId         String       @map("org_id")
  channel       String
  contactName   String       @map("contact_name")
  contactEmail  String?      @map("contact_email")
  contactPhone  String?      @map("contact_phone")
  subject       String?
  status        String       @default("OPEN")
  assignedTo    String?      @map("assigned_to")
  externalId    String?      @map("external_id")
  // Set when channel = 'CHAT' (live chat from the customer portal) — links
  // the conversation to the PortalUser on the other end, since name/email
  // string matching (used for email/WhatsApp) isn't reliable for an
  // authenticated portal session. Null for every other channel.
  portalUserId  String?      @map("portal_user_id")
  lastMessageAt DateTime?    @map("last_message_at")
  unreadCount   Int          @default(0) @map("unread_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  assignee      User?        @relation(fields: [assignedTo], references: [id])
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  portalUser    PortalUser?  @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([orgId])
  @@index([orgId, channel])
  @@index([portalUserId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  direction      String
  fromAddress    String       @map("from_address")
  toAddress      String       @map("to_address")
  body           String
  htmlBody       String?      @map("html_body")
  externalId     String?      @map("external_id")
  readAt         DateTime?    @map("read_at")
  sentAt         DateTime     @default(now()) @map("sent_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  // Email-sync dedupe looks messages up by externalId (Message-ID header) on
  // every synced email; without this index that was a sequential scan of an
  // ever-growing table, making sync slower forever.
  @@index([externalId])
  @@map("messages")
}

model Notification {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
