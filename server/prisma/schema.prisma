// ─── HR: Attendance ─────────────────────────────────────────────────────────

// An org's physical office(s) — attendance check-in/out is only accepted if
// the employee is within `radiusMeters` of at least one active location AND
// (unless skipped) their request's public IP matches `allowedIps`. Multiple
// rows support multi-branch orgs; a single-office org just has one.
model OfficeLocation {
  id            String       @id @default(cuid())
  orgId         String       @map("org_id")
  name          String
  latitude      Float
  longitude     Float
  radiusMeters  Int          @default(150) @map("radius_meters")
  // Comma-separated list of exact IPv4 addresses and/or basic CIDR blocks
  // (e.g. "203.0.113.5,198.51.100.0/24") — see utils/attendanceVerification.ts
  // ipMatchesAllowlist(). Blank/null means the IP check is skipped for this
  // location (geofence-only).
  allowedIps    String?      @map("allowed_ips")
  isActive      Boolean      @default(true) @map("is_active")
  /// Optional roll-up to the HR/asset Location concept. Null keeps the
  /// pre-existing standalone geo-fence behaviour untouched.
  locationId    String?      @map("location_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location      Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("office_locations")
}

// One row per check-in/check-out SESSION, not per day — an employee can
// check in and out multiple times in the same calendar day (e.g. steps out
// for lunch, a field visit, a split shift) and each session gets its own
// verification snapshot. A day's total worked time is the sum of
// (checkOutAt - checkInAt) across every session sharing that (userId, date)
// — see attendanceVerification.ts's sumWorkedMinutes() — rather than a
// single pair of columns, which only ever supported one session/day. A
// manager's manual entry (source = MANUAL) is just another session row that
// skips geofence/IP verification.
model AttendanceRecord {
  id                    String       @id @default(cuid())
  orgId                 String       @map("org_id")
  userId                String       @map("user_id")
  date                  DateTime     @db.Date
  checkInAt             DateTime?    @map("check_in_at")
  checkInLat            Float?       @map("check_in_lat")
  checkInLng            Float?       @map("check_in_lng")
  checkInIp             String?      @map("check_in_ip")
  checkInLocationOk     Boolean?     @map("check_in_location_ok")
  checkInNetworkOk      Boolean?     @map("check_in_network_ok")
  checkOutAt            DateTime?    @map("check_out_at")
  checkOutLat           Float?       @map("check_out_lat")
  checkOutLng           Float?       @map("check_out_lng")
  checkOutIp            String?      @map("check_out_ip")
  checkOutLocationOk    Boolean?     @map("check_out_location_ok")
  checkOutNetworkOk     Boolean?     @map("check_out_network_ok")
  // MANUAL rows are created by a manager (POST .../manual), not the
  // employee's own check-in/out, and skip geofence/IP verification entirely.
  source                String       @default("SELF") @map("source") // SELF | MANUAL
  notes                 String?
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([orgId, date])
  @@map("attendance_records")
}

// ─── HR: Leave Management ───────────────────────────────────────────────────

model LeaveType {
  id            String         @id @default(cuid())
  orgId         String         @map("org_id")
  name          String
  annualQuota   Int            @default(12) @map("annual_quota") // days per calendar year
  isPaid        Boolean        @default(true) @map("is_paid")
  color         String         @default("#6366f1")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("leave_types")
}

model LeaveRequest {
  id              String       @id @default(cuid())
  orgId           String       @map("org_id")
  userId          String       @map("user_id")
  leaveTypeId     String       @map("leave_type_id")
  startDate       DateTime     @db.Date @map("start_date")
  endDate         DateTime     @db.Date @map("end_date")
  days            Int          // inclusive whole-day count; half-days aren't supported
  reason          String?
  status          String       @default("PENDING") @map("status") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedBy       String?      @map("decided_by")
  decidedAt       DateTime?    @map("decided_at")
  rejectionReason String?      @map("rejection_reason")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  decider         User?        @relation("LeaveDecider", fields: [decidedBy], references: [id])
  leaveType       LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@index([orgId, userId])
  @@index([orgId, status])
  @@map("leave_requests")
}

// ─── HR: Payroll ─────────────────────────────────────────────────────────────

// An employee's current pay components. Editing (POST .../structures with an
// existing id in the body, see payroll.controller.ts upsertStructure)
// deactivates the prior row rather than mutating it in place, so past
// payslips keep pointing at the structure that was actually in effect when
// they were generated (Payslip.salaryStructureId, onDelete: SetNull) — only
// one row per (orgId, userId) has isActive true at a time.
model SalaryStructure {
  id              String   @id @default(cuid())
  orgId           String   @map("org_id")
  userId          String   @map("user_id")
  basic           Decimal  @db.Decimal(12, 2)
  hra             Decimal  @default(0) @db.Decimal(12, 2)
  allowances      Decimal  @default(0) @db.Decimal(12, 2)
  // Employer/employee provident-fund contribution, as a % of basic.
  pfPercent       Decimal  @default(12) @db.Decimal(5, 2) @map("pf_percent")
  professionalTax Decimal  @default(0) @db.Decimal(12, 2) @map("professional_tax")
  otherDeductions Decimal  @default(0) @db.Decimal(12, 2) @map("other_deductions")
  effectiveFrom   DateTime @db.Date @map("effective_from")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payslips        Payslip[]

  @@index([orgId, userId])
  @@map("salary_structures")
}

// One "process payroll for a month" action (payroll.controller.ts runPayroll)
// snapshots every active employee's current SalaryStructure into a Payslip.
// Re-running the same (orgId, month, year) is blocked by the unique
// constraint below — corrections happen on the individual Payslip rows, not
// by re-running the whole month.
model PayrollRun {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  month     Int // 1-12
  year      Int
  status    String   @default("PROCESSED") @map("status") // PROCESSED | PAID
  runBy     String   @map("run_by")
  runAt     DateTime @default(now()) @map("run_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runByUser User         @relation("PayrollRunCreator", fields: [runBy], references: [id])
  payslips  Payslip[]

  @@unique([orgId, month, year])
  @@index([orgId])
  @@map("payroll_runs")
}

// A generated payslip. Earnings/deductions are copied from the employee's
// SalaryStructure at generation time (not live-computed), so a later edit to
// the structure never rewrites history.
model Payslip {
  id                String    @id @default(cuid())
  orgId             String    @map("org_id")
  userId            String    @map("user_id")
  payrollRunId      String    @map("payroll_run_id")
  salaryStructureId String?   @map("salary_structure_id")
  // Sequential per-org display number, e.g. "PAY-2026-08-0001" — same
  // count-then-format approach as Invoice.invoiceNumber.
  payslipNumber     String    @map("payslip_number")
  month             Int
  year              Int
  basic             Decimal   @db.Decimal(12, 2)
  hra               Decimal   @db.Decimal(12, 2)
  allowances        Decimal   @db.Decimal(12, 2)
  grossPay          Decimal   @db.Decimal(12, 2) @map("gross_pay")
  pf                Decimal   @db.Decimal(12, 2)
  professionalTax   Decimal   @db.Decimal(12, 2) @map("professional_tax")
  otherDeductions   Decimal   @db.Decimal(12, 2) @map("other_deductions")
  totalDeductions   Decimal   @db.Decimal(12, 2) @map("total_deductions")
  netPay            Decimal   @db.Decimal(12, 2) @map("net_pay")
  status            String    @default("GENERATED") @map("status") // GENERATED | PAID
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  payrollRun      PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)

  @@unique([orgId, userId, month, year])
  @@index([orgId, month, year])
  @@map("payslips")
}

// The org's letterhead for the payslip PDF (browser print-to-PDF — see
// client/src/pages/PayslipPrintPage.tsx), designed once by an HR/org admin
// and applied to every employee's payslip. Singleton per org, same pattern
// as OrgBranding; GET /hr/payroll/template returns sensible defaults when no
// row exists yet so the print view always has something to render.
model PayslipTemplate {
  id             String   @id @default(cuid())
  orgId          String   @unique @map("org_id")
  companyName    String?  @map("company_name")
  companyAddress String?  @map("company_address")
  logoUrl        String?  @map("logo_url")
  primaryColor   String   @default("#2563eb") @map("primary_color")
  footerNote     String?  @map("footer_note")
  showSignature  Boolean  @default(true) @map("show_signature")
  signatureLabel String   @default("Authorized Signatory") @map("signature_label")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("payslip_templates")
}

// ─── Invoicing ───────────────────────────────────────────────────────────────

// Generated automatically when a Quote is accepted (see quotes.controller.ts
// publicAccept), or created manually. Document-only — no payment processor
// integration; staff mark status by hand (mirrors how Quote status already
// works). Shared publicly via the same deterministic-HMAC-token pattern as
// Quote's share link (see invoices.controller.ts invoiceShareToken).
model Invoice {
  id            String        @id @default(cuid())
  orgId         String        @map("org_id")
  quoteId       String?       @map("quote_id")
  dealId        String?       @map("deal_id")
  // Sequential per-org display number, e.g. "INV-0001" — assigned at
  // creation from a per-org counter (see invoices.controller.ts
  // nextInvoiceNumber). Immutable once set.
  invoiceNumber String        @map("invoice_number")
  title         String
  status        String        @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | VOID
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  taxRate       Decimal       @default(0) @db.Decimal(5, 2) @map("tax_rate") // percent
  notes         String?
  paidAt        DateTime?     @map("paid_at")
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lines         InvoiceLine[]
  creator       User          @relation("InvoiceCreator", fields: [createdBy], references: [id])
  deal          Deal?         @relation(fields: [dealId], references: [id])
  quote         Quote?        @relation(fields: [quoteId], references: [id])
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model TOTPSecret {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
