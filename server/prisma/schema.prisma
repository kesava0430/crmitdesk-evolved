  // In-app e-signature capture, set when a quote transitions to ACCEPTED via
  // the customer-facing accept link (see quotes.controller.ts acceptQuote).
  // Not a legally-certified e-signature product — a hand-drawn signature
  // (signatureImage, a base64 PNG data URL from a canvas pad) plus a typed
  // name/email and an IP/timestamp audit trail, stamped onto the quote view.
  signerName     String?   @map("signer_name")
  signerEmail    String?   @map("signer_email")
  signedAt       DateTime? @map("signed_at")
  signerIp       String?   @map("signer_ip")
  signatureImage String?   @map("signature_image") @db.Text
  lines      QuoteLine[]
  creator    User         @relation("QuoteCreator", fields: [createdBy], references: [id])
  deal       Deal?        @relation(fields: [dealId], references: [id])
