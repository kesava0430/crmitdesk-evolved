// ─── AI Studio ────────────────────────────────────────────────────────────────

model BusinessContext {
  id             String       @id @default(cuid())
  orgId          String       @unique @map("org_id")
  industry       String?
  companyDesc    String?      @map("company_desc")
  terminology    Json?        // Record<string, string> — custom term → definition, fed into AI prompts only
  // UI-facing relabeling, distinct from `terminology` above: that field only
  // ever flavors AI prompt text, it was never read by the React UI. This one
  // actually drives what the product displays — shape is
  // { entities: { ticket: { singular, plural }, deal: {...}, ... },
  //   fields:   { ticket: { priority: "Severity", ... }, ... } }
  // Populated via the "Generate setup" AI flow (see aiStudio.controller.ts
  // generateSetup/applySetup) or edited directly.
  labelOverrides Json?        @map("label_overrides")
  customSystem   String?      @map("custom_system") // extra context injected into AI calls
  tone           String       @default("professional") // professional | casual | technical
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("business_contexts")
}

model CustomAIFunction {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  name         String
  description  String?
  systemPrompt String       @map("system_prompt")
  inputSchema  Json         @map("input_schema") // [{name, type, label, required}]
  outputType   String       @default("text") @map("output_type") // text | json | number
  isActive     Boolean      @default(true) @map("is_active")
  runCount     Int          @default(0) @map("run_count")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("custom_ai_functions")
}

model CustomScript {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  name        String
  description String?
  entityType  String       @map("entity_type") // ticket | contact | deal | lead | asset | global
  trigger     String       // onLoad | onChange | onSubmit | onValidate | onFieldChange
  fieldTarget String?      @map("field_target") // specific field name, null = entity-level
  script      String       // sandboxed JS — runs in ScriptEngine
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, trigger])
  @@map("custom_scripts")
}
