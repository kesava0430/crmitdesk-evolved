  // Only set when trigger = 'DATE_FIELD_REACHED': { entityType: 'CONTACT' |
  // 'CUSTOM_MODULE', moduleId?, dateField, offsetDays, recurrence: 'ONCE' |
  // 'YEARLY' }. See utils/dateAutomation.ts for the poller that reads it.
  dateConfig  Json?         @map("date_config")
  isActive    Boolean       @default(true) @map("is_active")
  runCount    Int           @default(0) @map("run_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  logs        WorkflowLog[]
