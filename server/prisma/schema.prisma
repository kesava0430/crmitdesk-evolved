model CustomField {
  id         String             @id @default(cuid())
  orgId      String             @map("org_id")
  entityType String             @map("entity_type")
  label      String
  fieldKey   String             @map("field_key")
  fieldType  String             @map("field_type")
  options    Json?
  required   Boolean            @default(false)
  position   Int                @default(0)
  // Prefilled into a CREATE form only — never applied to records that already
  // exist, and never written on the server, so it stays a suggestion the user
  // can overwrite before saving rather than a value that appears by itself.
  // Stored as text like every CustomFieldValue.value; the field's own
  // fieldType decides how it is parsed.
  defaultValue String?          @map("default_value")
  // ── Conditional visibility ──
  // When set, this field is only shown once `dependsOn`'s current value is one
  // of `dependsOnValues`. The parent is constrained to SELECT/BOOLEAN, since
  // those are the types with a knowable set of values to pick from.
  //
  // onDelete: SetNull, not Cascade: deleting the parent must not delete the
  // dependent field (and its stored values) — it just stops being conditional
  // and becomes always-visible, which is the recoverable direction to fail in.
  dependsOnFieldId String?      @map("depends_on_field_id")
  dependsOn        CustomField? @relation("CustomFieldDependency", fields: [dependsOnFieldId], references: [id], onDelete: SetNull)
  dependents       CustomField[] @relation("CustomFieldDependency")
  /// Array of parent values that reveal this field, e.g. ["HIGH","CRITICAL"].
  dependsOnValues  Json?        @map("depends_on_values")
  createdAt  DateTime           @default(now()) @map("created_at")
  values     CustomFieldValue[]
  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, fieldKey])
  @@index([orgId, entityType])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String      @map("custom_field_id")
  entityId      String      @map("entity_id")
  value         String?
  field         CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

// ─── Custom Modules (no-code object builder) ───────────────────────────────────
//
// Distinct from CustomField above: CustomField bolts extra fields onto an
// *existing* entity (Ticket/Deal/...). A CustomModule is a brand-new entity
// type an org admin defines from scratch — its own fields, its own records,
// its own nav entry — closer to a Salesforce custom object than a form
// field. Record data is stored schemaless as `data: Json` keyed by
// `fieldKey` (mirrors the CustomFieldValue pattern of storing everything as
// a string-able value) rather than a dynamically-altered SQL table, since
// Postgres DDL can't be safely run per-tenant from application code.
model CustomModule {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  name        String
  slug        String
  icon        String    @default("Layers")
  description String?
  // Which sidebar section (AppLayout.tsx's NAV_SECTIONS) this module's nav
  // entry gets folded into — CRM | IT_DESK | HR | ADMIN. Plain string rather
  // than a Postgres enum since it only ever needs to round-trip through the
  // client's own picker and has no other consumer that needs DB-level
  // constraint checking; an unrecognized value just falls back to CRM in the
  // sidebar (see AppLayout.tsx). Defaults to CRM to match this feature's
  // original (pre-picker) hardcoded placement.
  navSection  String    @default("CRM") @map("nav_section")
  // Pipeline stages (Phase 2 of the platform play) — ordered array of
  // { key, label, color } objects. When set, the module's records carry a
  // `stage` and the client offers a kanban board view; when null the module
  // is a plain table, exactly as before. Validated in customModules.controller
  // (StagesSchema) — kept as JSON so reordering/renaming stages is one
  // update, not a migration.
  stages      Json?     @map("stages")
  // Ordered fieldKeys shown as list-view columns. Null = default (first 5).
  listColumns Json?     @map("list_columns")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fields      CustomModuleField[]
  records     CustomModuleRecord[]
  syncConfig  ExternalSyncConfig?

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("custom_modules")
}

model CustomModuleField {
  id        String       @id @default(cuid())
  moduleId  String       @map("module_id")
  label     String
  fieldKey  String       @map("field_key")
  // TEXT | TEXTAREA | NUMBER | CURRENCY | DATE | BOOLEAN | DROPDOWN | EMAIL | PHONE | URL | RELATION
  fieldType String       @map("field_type")
  options   Json?        // DROPDOWN: string[] of choices
  // RELATION fields: the CustomModule this field points at (same org; may be
  // this module itself for parent/child links). The record stores the target
  // record's id in data[fieldKey].
  relationModuleId String? @map("relation_module_id")
  // OR a core entity — CONTACT | ACCOUNT | DEAL | TICKET — so custom records
  // can hang off the CRM/desk spine ("this Vehicle's Buyer is contact X"),
  // and the universal related view (related.controller.ts) can list them
  // under that contact/deal/ticket. Exactly one of relationModuleId /
  // relationEntity is set for a RELATION field.
  relationEntity   String? @map("relation_entity")
  required  Boolean      @default(false)
  isPrimary Boolean      @default(false) @map("is_primary") // rendered as the record's title in list views
  position  Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  module    CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, fieldKey])
  @@index([moduleId])
  @@map("custom_module_fields")
}

model CustomModuleRecord {
  id         String       @id @default(cuid())
  moduleId   String       @map("module_id")
  orgId      String       @map("org_id")
  data       Json         // { [fieldKey]: value }
  // Current pipeline stage key (one of the module's stages[].key), null for
  // modules without stages or records created before stages were added —
  // the client buckets those under the first stage on the board.
  stage      String?      @map("stage")
  source     String       @default("MANUAL") // MANUAL | SYNC
  // Dedupe key for SYNC-sourced records — the value of the external system's
  // id field (ExternalSyncConfig.externalIdField), so re-polling upserts
  // instead of duplicating. Null for MANUAL records.
  externalId String?      @map("external_id")
  createdBy  String?      @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  module     CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([moduleId, externalId])
  @@index([moduleId])
  @@index([moduleId, stage])
  @@index([orgId])
  @@map("custom_module_records")
}

// Outbound-polling sync: we periodically GET/POST a configured external URL,
// pull records out of the response (at `recordPath`), validate each one
// against the module's field schema, and upsert into CustomModuleRecord
// (deduped on `externalIdField`). Follows the same setInterval-poller shape
// as scheduler.ts — see server/src/utils/customModuleSync.ts.
model ExternalSyncConfig {
  id              String       @id @default(cuid())
  moduleId        String       @unique @map("module_id")
  url             String
  method          String       @default("GET")
  authType        String       @default("NONE") @map("auth_type") // NONE | API_KEY | BEARER
  authHeaderName  String?      @map("auth_header_name")
  authValue       String?      @map("auth_value")
  pollIntervalMin Int          @default(15) @map("poll_interval_min")
  recordPath      String?      @map("record_path")       // dot path to the array of records in the response, e.g. "data.items"
  externalIdField String?      @map("external_id_field") // key (in the *external* record) used to dedupe on re-sync
  fieldMapping    Json         @map("field_mapping")      // { [customModuleFieldKey]: externalResponseKey }
  isActive        Boolean      @default(true) @map("is_active")
  lastSyncAt      DateTime?    @map("last_sync_at")
  lastStatus      String?      @map("last_status") // SUCCESS | FAILED
  lastError       String?      @map("last_error")
  lastRecordCount Int?         @map("last_record_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  module          CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("external_sync_configs")
}

// ─── Templates ────────────────────────────────────────────────────────────────

