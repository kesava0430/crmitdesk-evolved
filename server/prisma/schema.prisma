  @@unique([customFieldId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

// ─── Templates ────────────────────────────────────────────────────────────────

// A named set of default field values (standard + custom) for one entity
// type. Picking a template on the entity's "New" form pre-fills the form —
// it does not create the record by itself.
model RecordTemplate {
  id                String       @id @default(cuid())
  orgId             String       @map("org_id")
  entityType        String       @map("entity_type") // TICKET | CONTACT | DEAL | LEAD
  name              String
  description       String?
  fieldValues       Json         @map("field_values")       // default values for standard fields, e.g. { priority: "HIGH" }
  customFieldValues Json?        @map("custom_field_values") // default values for custom fields, keyed by fieldKey
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, name])
  @@index([orgId, entityType])
  @@map("record_templates")
}

// Canned responses agents can insert while replying/commenting on a ticket.
model ReplyTemplate {
  id        String       @id @default(cuid())
  orgId     String       @map("org_id")
  name      String
  body      String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("reply_templates")
}

// Reusable subject/body pairs selectable when creating a Campaign.
