generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  plan           String             @default("FREE")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  aiCustomRules     AICustomRule[]
  businessContext   BusinessContext?
  customAIFunctions CustomAIFunction[]
  customScripts     CustomScript[]
  accounts          Account[]
  activities     Activity[]
  apiKeys        ApiKey[]
  assets         Asset[]
  campaigns      Campaign[]
  categories     Category[]
  changeRequests ChangeRequest[]
  contacts       Contact[]
  conversations  Conversation[]
  csatResponses  CsatResponse[]
  customFields   CustomField[]
  customModules  CustomModule[]
  customModuleRecords CustomModuleRecord[]
  deals          Deal[]
  recordTemplates RecordTemplate[]
  replyTemplates  ReplyTemplate[]
  emailTemplates  EmailTemplate[]
  quoteTemplates  QuoteTemplate[]
  emailAccount   EmailAccount?
  inviteTokens   InviteToken[]
  articles       KnowledgeArticle[]
  leads          Lead[]
  notifications  Notification[]
  branding       OrgBranding?
  pipelines      Pipeline[]
  portalUsers    PortalUser[]
  pushSubscriptions PushSubscription[]
  quotes         Quote[]
  schedules      Schedule[]
  slaPolicies    SlaPolicy[]
  slackConfig    SlackConfig?
  subscription   Subscription?
  tags           Tag[]
  teamsConfig    TeamsConfig?
  tickets        Ticket[]
  timeEntries    TimeEntry[]
  users          User[]
  usageEvents    UsageEvent[]
  whatsAppConfig WhatsAppConfig?
  workflowRules  WorkflowRule[]
  storageConfig  StorageConfig?
  officeLocations   OfficeLocation[]
  attendanceRecords AttendanceRecord[]
  leaveTypes        LeaveType[]
  leaveRequests     LeaveRequest[]
  invoices          Invoice[]
  salaryStructures  SalaryStructure[]
  payrollRuns       PayrollRun[]
  payslips          Payslip[]
  payslipTemplate   PayslipTemplate?
  directoryConfig   DirectoryConfig?

  @@map("organizations")
}

// Lightweight per-event usage log — currently AI_CALL, WHATSAPP_SEND, and
// EMAIL_SEND. No billing enforcement reads this yet (see
// utils/usageTracking.ts); it exists purely so real usage patterns are
// visible before we set any included-quota/overage numbers, rather than
// guessing at limits with no data. One row per event rather than a rolling
// counter, so it can be sliced by day/type once there's enough history to
// actually decide.
//
// `source` distinguishes, for WHATSAPP_SEND/EMAIL_SEND, whether the org's
// own connected account was used ('OWN') or the platform's shared
// fallback was ('PLATFORM') — see utils/whatsapp.ts and utils/mailer.ts.
// Null for event types where the distinction doesn't apply (AI_CALL) or
// for rows recorded before this column existed.
model UsageEvent {
  id        String       @id @default(cuid())
  orgId     String       @map("org_id")
  type      String
  source    String?
  createdAt DateTime     @default(now()) @map("created_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, type, createdAt])
  @@map("usage_events")
}

// Singleton row (always id = 'platform') holding the platform-wide email/
// WhatsApp *fallback* sending config — the account used when an org hasn't
// connected its own (see utils/whatsapp.ts, utils/mailer.ts). Lets a
// PLATFORM_ADMIN change these live from the console instead of editing
// Render env vars and redeploying. Every field is optional and layers over
// the matching env var — see utils/platformSettings.ts's getPlatformMailConfig/
// getPlatformWhatsAppConfig: a blank field here just means "use the env var".
// Secrets (resendApiKey, smtpPass, twilioAuthToken) are stored encrypted via
// utils/crypto.ts's encryptSecret, same as EmailAccount.password.
model PlatformSettings {
  id               String   @id @default("platform")
  resendApiKey     String?  @map("resend_api_key")
  resendFrom       String?  @map("resend_from")
  smtpHost         String?  @map("smtp_host")
  smtpPort         Int?     @map("smtp_port")
  smtpUser         String?  @map("smtp_user")
  smtpPass         String?  @map("smtp_pass")
  smtpFrom         String?  @map("smtp_from")
  twilioAccountSid String?  @map("twilio_account_sid")
  twilioAuthToken  String?  @map("twilio_auth_token")
  twilioFromNumber String?  @map("twilio_from_number")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// A "create new org" signup submitted via the public register form. Nothing
// in Organization/User is written until an admin approves it (see
// auth.controller.ts register()/approveOrgSignup()) — this table is the only
// trace of the request until then, holding everything needed to create the
// org + first SUPER_ADMIN user later without asking the requester to log in
// again or re-enter their password.
model OrgSignupRequest {
  id               String    @id @default(cuid())
  organizationName String    @map("organization_name")
  name             String
  email            String
  passwordHash     String    @map("password_hash")
  token            String    @unique
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt        DateTime  @default(now()) @map("created_at")
  decidedAt        DateTime? @map("decided_at")

  @@map("org_signup_requests")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model InviteToken {
  id        String       @id @default(cuid())
  orgId     String       @map("org_id")
  email     String
  role      UserRole     @default(EMPLOYEE)
  token     String       @unique
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  passwordHash           String             @map("password_hash")
  role                   UserRole           @default(EMPLOYEE)
  department             String?
  phone                  String? // E.164 format (e.g. +14155551234) — used to resolve the "ASSIGNEE" recipient for scheduled/workflow WhatsApp notifications
  avatarUrl              String?            @map("avatar_url")
  isActive               Boolean            @default(true) @map("is_active")
  // Google SSO linking. A user links their Google account from their Profile
  // page (must already have a staff account — SSO does not create new orgs
  // or bypass the invite/approval-gated signup flow); once set, login also
  // accepts a verified Google ID token in place of a password. Unique so no
  // two staff users can link the same Google account.
  googleId               String?            @unique @map("google_id")
  // Microsoft Entra ID SSO linking — same shape as googleId above, set the
  // first time a user signs in via their org's configured Entra tenant
  // (matched first by this id, falling back to a one-time email match on
  // first SSO login — see auth.controller.ts entraCallback()). Unique so an
  // Entra identity can't end up linked to two different CRMITdesk users.
  entraObjectId          String?            @unique @map("entra_object_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  orgId                  String?            @map("org_id")
  passwordResetTokens    PasswordResetToken[]
  calendarConnection     CalendarConnection?
  ownedAccounts          Account[]          @relation("AccountOwner")
  activities             Activity[]
  apiKeys                ApiKey[]
  assignedAssets         Asset[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  changeRequestsAssigned ChangeRequest[]    @relation("ChangeAssignee")
  changeRequestsMade     ChangeRequest[]    @relation("ChangeRequester")
  comments               Comment[]
  ownedContacts          Contact[]          @relation("ContactOwner")
  assignedConversations  Conversation[]
  assignedDeals          Deal[]             @relation("DealAssignee")
  knowledgeArticles      KnowledgeArticle[]
  assignedLeads          Lead[]             @relation("LeadAssignee")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  quotesCreated          Quote[]            @relation("QuoteCreator")
  refreshTokens          RefreshToken[]
  schedulesCreated       Schedule[]
  slaPoliciesToNotify    SlaPolicy[]        @relation("SlaPolicyNotifyUser")
  assignedTickets        Ticket[]           @relation("TicketAssignee")
  requestedTickets       Ticket[]           @relation("TicketRequester")
  timeEntries            TimeEntry[]
  totpSecret             TOTPSecret?
  org                    Organization?      @relation(fields: [orgId], references: [id])
  storageConfigsConnected StorageConfig[]
  attendanceRecords      AttendanceRecord[]
  leaveRequests          LeaveRequest[]     @relation("LeaveRequester")
  leaveRequestsDecided   LeaveRequest[]     @relation("LeaveDecider")
  invoicesCreated        Invoice[]          @relation("InvoiceCreator")
  salaryStructures       SalaryStructure[]
  payslips               Payslip[]
  payrollRunsCreated     PayrollRun[]       @relation("PayrollRunCreator")

  @@map("users")
}

// Staff forgot-password flow. tokenHash is SHA-256 of the raw token emailed
// to the user (same pattern as PortalToken/RefreshToken — the raw token is
// never persisted). 30-minute expiry, single use (usedAt set on consumption).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Per-user (not per-org) Google Calendar connection — each staff member
// links their own calendar, mirroring how Google Calendar accounts work
// personally rather than as an org-wide resource. Powers a one-way push of
// Activities (due date) and assigned Tickets (SLA due date) as calendar
// events; see utils/googleCalendar.ts.
model CalendarConnection {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  provider       String    @default("GOOGLE_CALENDAR") @map("provider")
  accessToken    String    @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  calendarId     String    @default("primary") @map("calendar_id")
  connectedEmail String?   @map("connected_email")
  syncActivities Boolean   @default(true) @map("sync_activities")
  syncTickets    Boolean   @default(true) @map("sync_tickets")
  lastSyncAt     DateTime? @map("last_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_connections")
}

model Comment {
  id         String     @id @default(cuid())
  authorId   String     @map("author_id")
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")
  body       String
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("comments")
}

// Files never touch our own storage — fileUrl/providerFileId point at wherever
// the org's connected drive (see StorageConfig below) actually holds the
// bytes. provider is snapshotted per-row (not just read off StorageConfig)
// so an attachment uploaded before an org switches providers still knows
// which API to call for its own download/delete.
model Attachment {
  id             String     @id @default(cuid())
  uploaderId     String     @map("uploader_id")
  entityType     EntityType @map("entity_type")
  entityId       String     @map("entity_id")
  fileName       String     @map("file_name")
  fileUrl        String     @map("file_url")
  provider       String     @default("GOOGLE_DRIVE") @map("provider")
  providerFileId String     @map("provider_file_id")
  fileSize       Int        @map("file_size")
  mimeType       String     @map("mime_type")
  createdAt      DateTime   @default(now()) @map("created_at")
  uploader       User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("attachments")
}

// Org-level "bring your own drive" connection. Only one provider connected
// per org at a time (unique orgId) — reconnecting with a different provider
// overwrites this row. Existing HOSTED_S3 Attachment rows keep working
// regardless, since each one recorded its own provider/providerFileId at
// upload time and S3 access needs no per-org config. GOOGLE_DRIVE
// attachments are NOT that resilient — they need this row's live
// accessToken/refreshToken, so switching away from Drive (to hosted
// storage, disconnecting, or reconnecting a different Drive account) would
// strand them; storage.controller.ts blocks those transitions while any
// exist (assertWontOrphanDriveAttachments).
model StorageConfig {
  id                String       @id @default(cuid())
  orgId             String       @unique @map("org_id")
  // 'GOOGLE_DRIVE' (bring-your-own, OAuth) or 'HOSTED_S3' (we host it,
  // requires a paid plan with a storage quota — see PLANS.storageQuotaGB
  // in utils/stripe.ts). The five fields below are OAuth-only and stay
  // null for HOSTED_S3, which has no per-org connection details — just a
  // shared bucket keyed by orgId (see utils/s3Storage.ts).
  provider          String       @default("GOOGLE_DRIVE") @map("provider")
  accessToken       String?      @map("access_token")
  refreshToken      String?      @map("refresh_token")
  tokenExpiresAt    DateTime?    @map("token_expires_at")
  rootFolderId      String?      @map("root_folder_id")
  connectedEmail    String?      @map("connected_email")
  connectedByUserId String       @map("connected_by_user_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectedBy       User         @relation(fields: [connectedByUserId], references: [id])

  @@map("storage_configs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Tag {
  id          String       @id @default(cuid())
  name        String
  color       String       @default("#6B7280")
  module      String       @default("ALL")
  orgId       String       @map("org_id")
  contactTags ContactTag[]
  dealTags    DealTag[]
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("tags")
}

model Contact {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  jobTitle    String?      @map("job_title")
  accountId   String?      @map("account_id")
  source      String?
  // Date-only (time component ignored) — powers the DATE_FIELD_REACHED
  // workflow trigger's YEARLY recurrence (birthday wishes). See
  // utils/dateAutomation.ts.
  dateOfBirth DateTime?    @map("date_of_birth")
  ownerId     String       @map("owner_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  orgId       String       @map("org_id")
  activities Activity[]
  tags       ContactTag[]
  account    Account?     @relation(fields: [accountId], references: [id])
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner      User         @relation("ContactOwner", fields: [ownerId], references: [id])
  deals      Deal[]
  leads      Lead[]
  tickets    Ticket[]

  @@index([orgId])
  @@map("contacts")
}

model ContactTag {
  contactId String  @map("contact_id")
  tagId     String  @map("tag_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Account {
  id        String       @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  address   String?
  ownerId   String       @map("owner_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     User         @relation("AccountOwner", fields: [ownerId], references: [id])
  contacts  Contact[]
  deals     Deal[]

  @@index([orgId])
  @@map("accounts")
}

model Pipeline {
  id        String       @id @default(cuid())
  name      String
  stages    Json
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at")
  orgId     String       @map("org_id")
  deals     Deal[]
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("pipelines")
}

model Lead {
  id            String       @id @default(cuid())
  contactId     String?      @map("contact_id")
  source        String?
  status        LeadStatus   @default(NEW)
  assignedTo    String?      @map("assigned_to")
  convertedAt   DateTime?    @map("converted_at")
  dealId        String?      @map("deal_id")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  aiScore       Int?         @map("ai_score")
  aiScoreReason String?      @map("ai_score_reason")
  orgId         String       @map("org_id")
  activities    Activity[]
  assignee      User?        @relation("LeadAssignee", fields: [assignedTo], references: [id])
  contact       Contact?     @relation(fields: [contactId], references: [id])
  deal          Deal?        @relation(fields: [dealId], references: [id])
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("leads")
}

model Deal {
  id          String        @id @default(cuid())
  title       String
  value       Decimal       @default(0) @db.Decimal(12, 2)
  stage       String
  probability Int           @default(0)
  closeDate   DateTime?     @map("close_date")
  pipelineId  String?       @map("pipeline_id")
  contactId   String?       @map("contact_id")
  accountId   String?       @map("account_id")
  assignedTo  String?       @map("assigned_to")
  status      DealStatus    @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  orgId       String        @map("org_id")
  activities  Activity[]
  history     DealHistory[]
  tags        DealTag[]
  account     Account?      @relation(fields: [accountId], references: [id])
  assignee    User?         @relation("DealAssignee", fields: [assignedTo], references: [id])
  contact     Contact?      @relation(fields: [contactId], references: [id])
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline    Pipeline?     @relation(fields: [pipelineId], references: [id])
  leads       Lead[]
  quotes      Quote[]
  invoices    Invoice[]

  @@index([orgId])
  @@map("deals")
}

model DealTag {
  dealId String @map("deal_id")
  tagId  String @map("tag_id")
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@map("deal_tags")
}

model DealHistory {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id")
  fromStage String?  @map("from_stage")
  toStage   String   @map("to_stage")
  changedBy String   @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("deal_history")
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  title         String
  body          String?
  dealId        String?      @map("deal_id")
  contactId     String?      @map("contact_id")
  // Follow-up activities (calls/emails/meetings/tasks) scheduled against a
  // Lead before it's converted to a Deal. Nullable — existing deal/contact
  // activities are untouched. See leads.controller.ts listActivities/
  // createActivity/completeActivity.
  leadId        String?      @map("lead_id")
  dueAt         DateTime?    @map("due_at")
  done          Boolean      @default(false)
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  orgId         String       @map("org_id")
  contact       Contact?     @relation(fields: [contactId], references: [id])
  createdByUser User         @relation(fields: [createdBy], references: [id])
  deal          Deal?        @relation(fields: [dealId], references: [id])
  lead          Lead?        @relation(fields: [leadId], references: [id])
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([leadId])
  @@map("activities")
}

model SlaPolicy {
  id                String       @id @default(cuid())
  name              String
  responseHours     Int          @map("response_hours")
  resolutionHours   Int          @map("resolution_hours")
  priorityOverrides Json?        @map("priority_overrides")
  // Who gets an in-app + push notification when a ticket under this policy
  // breaches its resolution deadline (see utils/slaMonitor.ts). Optional —
  // orgs that would rather route breaches through a Workflows rule (any
  // recipient logic, Slack/Teams/email/WhatsApp) can leave this unset and
  // build an SLA_BREACH-triggered rule instead; the two aren't exclusive,
  // both fire on the same breach event.
  notifyUserId      String?      @map("notify_user_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  orgId             String       @map("org_id")
  categories        Category[]
  notifyUser        User?        @relation("SlaPolicyNotifyUser", fields: [notifyUserId], references: [id])
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("sla_policies")
}

model Category {
  id              String             @id @default(cuid())
  name            String
  parentId        String?            @map("parent_id")
  slaPolicyId     String?            @map("sla_policy_id")
  autoAssignGroup String?            @map("auto_assign_group")
  createdAt       DateTime           @default(now()) @map("created_at")
  orgId           String             @map("org_id")
  org             Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent          Category?          @relation("CategoryParent", fields: [parentId], references: [id])
  children        Category[]         @relation("CategoryParent")
  slaPolicy       SlaPolicy?         @relation(fields: [slaPolicyId], references: [id])
  articles        KnowledgeArticle[]
  tickets         Ticket[]

  @@index([orgId])
  @@map("categories")
}

model Ticket {
  id            String          @id @default(cuid())
  title         String
  body          String
  categoryId    String?         @map("category_id")
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  requesterId   String          @map("requester_id")
  // Set when an agent creates a ticket "on behalf of" a CRM Contact rather
  // than an internal User (Contacts have no login, so requesterId still has
  // to point at *some* User — the creating agent's own id — for the ticket
  // to satisfy that required FK; this field is what actually identifies the
  // real requester in that case). Also what SEND_CSAT_SURVEY / SEND_WHATSAPP
  // resolve against when an automation's recipient is set to "the linked
  // contact" — see notification-recipient.ts.
  contactId     String?         @map("contact_id")
  assignedTo    String?         @map("assigned_to")
  slaDueAt      DateTime?       @map("sla_due_at")
  resolvedAt    DateTime?       @map("resolved_at")
  closedAt      DateTime?       @map("closed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  orgId         String          @map("org_id")
  portalUserId  String?         @map("portal_user_id")
  sentiment     String?         @default("NEUTRAL")
  csatResponses CsatResponse[]
  breaches      SlaBreaches[]
  assets        TicketAsset[]
