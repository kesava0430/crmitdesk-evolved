<?xml version="1.0" encoding="utf-8"?>
<!--
  The API is served over HTTPS (https://app.zenkara.in/zenkara/api), so no
  remote host needs a cleartext exception any more — the old exception for
  the raw EC2 IP (13.48.19.159) has been removed.

  The one cleartext origin left is the app itself: the WebView serves the
  bundle from http://localhost (androidScheme 'http' in capacitor.config.ts).
  Keep it until sessions are migrated off the WebView's localStorage — see the
  note in capacitor.config.ts before ever changing the scheme.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
